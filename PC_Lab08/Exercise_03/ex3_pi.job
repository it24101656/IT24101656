#!/bin/bash
# Slurm job script for ARCHER2 - runs ./ex3_pi
# Override task counts from the command line, e.g.  sbatch --tasks-per-node=8 ex3_pi.job
#SBATCH --nodes=1
#SBATCH --tasks-per-node=4
#SBATCH --job-name=ex3_pi
#SBATCH --time=00:01:00
#SBATCH --output=%x-%j.out
#SBATCH --cpus-per-task=1
#SBATCH --partition=standard
#SBATCH --account=ta035
#SBATCH --qos=short
#SBATCH --reservation=shortqos

module --silent load epcc-job-env
export OMP_NUM_THREADS=1

srun --distribution=block:block --hint=nomultithread ./ex3_pi
